VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# MAPID Maps — dari geo.mapid.io > Dasbor > Map Services > Styles > Styles Privat > GL Style
# Ambil URL SEBELUM tanda "?key=..." untuk VITE_MAPID_MAPS_STYLE_URL,
# dan nilai setelah "key=" untuk VITE_MAPID_MAPS_API_KEY.
# Contoh style yang tersedia: street-2d-building, basic (cek tab Styles untuk daftar lengkap)
VITE_MAPID_MAPS_STYLE_URL=https://basemap.mapid.io/styles/basic/style.json
VITE_MAPID_MAPS_API_KEY=(your-mapid-key-here)

# Basemap kedua (opsional) untuk toggle Peta/Satelit di MapView — style beda,
# key SAMA dengan VITE_MAPID_MAPS_API_KEY di atas. Kalau tidak diisi, tombol
# "Satelit" jatuh ke fallback OSM raster (sama seperti VITE_MAPID_MAPS_STYLE_URL
# kosong).
VITE_MAPID_MAPS_SATELLITE_STYLE_URL=https://basemap.mapid.io/styles/satellite/style.json

# Login wall internal (Supabase Auth email+password) — DEFAULT OFF.
# Biarkan tidak diset / apa pun selain string 'true' = aplikasi terbuka tanpa login
# (dipakai untuk submission WebGIS). Set 'true' HANYA untuk mengaktifkan gerbang
# login internal Dishub/Bappeda — akun staf dibuat manual lewat Supabase Dashboard
# (tidak ada signup di UI). Butuh VITE_SUPABASE_URL/ANON_KEY terisi agar berlaku.
VITE_AUTH_REQUIRED=false

# ⚠️ JANGAN taruh ANTHROPIC_API_KEY di sini dengan prefix VITE_ —
# prefix VITE_ artinya Vite akan membundel nilainya ke JS publik,
# bisa dilihat siapa pun lewat DevTools browser.
#
# ANTHROPIC_API_KEY yang benar disimpan sebagai Supabase secret,
# dipanggil dari Edge Function (supabase/functions/ai-insight),
# BUKAN dari frontend. Set lewat:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxxxx
#
# Catatan: VITE_MAPID_MAPS_API_KEY di atas BEDA kasus dengan ANTHROPIC_API_KEY —
# key basemap peta memang didesain dipakai di sisi browser (semua penyedia
# basemap: Mapbox, MapTiler, MAPID, bekerja seperti ini), biasanya dibatasi
# lewat domain/referrer di dashboard, bukan lewat kerahasiaan penuh.
