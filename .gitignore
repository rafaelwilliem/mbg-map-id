# ===== Office lock/temp files (dibuat otomatis saat file Excel/Word dibuka) =====
~$*

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
ENV/

# ===== Environment / Secrets (JANGAN DI-COMMIT) =====
.env
.env.*
!.env.example
*.key
credentials.json
NOTION_API_KEY*

# ===== Supabase CLI (state lokal, bukan source code) =====
supabase/.temp/

# ===== Node / Frontend =====
node_modules/
npm-debug.log*
yarn-error.log
dist/
.vite
.next/
out/

# ===== OS =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== Editor / IDE =====
.vscode/
.idea/
*.swp
*.swo

# ===== Data (raw besar di-ignore; hasil olahan boleh di-track) =====
data/raw/
*.zip
*.7z
# Cache mentah tile Overpass (etl/fetch_osm_building_footprints.py) — JSON per-tile,
# total bisa ratusan MB untuk seluruh Kota Bekasi, murni cache lokal supaya re-run
# tidak query ulang tile yang sudah berhasil. Hasil akhirnya (building_footprint_bekasi.geojson)
# sudah di-ignore lewat *.geojson di bawah.
etl/data/osm/_building_tiles_raw/

# ===== Geo / Large binaries =====
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.geojson
# data olahan (kecil, sintetis) tetap di-track supaya tidak hilang dari version control
!data/processed/*.geojson
# aset GeoJSON kecil yang di-bundle frontend saat build (mis. batas area studi) —
# WAJIB di-track, kalau tidak build dari clone bersih (Vercel) gagal di import
!frontend/src/data/*.geojson

# ===== Logs =====
*.log

# ===== ETL jejak komputasi (artefak recovery, bukan sumber) =====
etl/data/_*.csv
